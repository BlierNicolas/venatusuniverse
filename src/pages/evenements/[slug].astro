---
import Layout from '../../layouts/Layout.astro';
import EventDetail from '../../components/EventDetail.astro';
import { contentfulClient, type Event } from '../../lib/contentful';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Event>({ content_type: 'evenements', locale: 'fr-CA' });
  return response.items.map((item) => ({
    params: { slug: item.sys.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'fr';
const pageTitle = item.fields.title;
---
<Layout pageTitle={pageTitle} breadcrumbs={[{ label: t('events', locale), url: '/evenements' }, { label: item.fields.title }]}>
  <main>
    <EventDetail item={item} locale={locale} />
  </main>
</Layout>
