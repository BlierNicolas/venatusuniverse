---
import Layout from '../../../layouts/Layout.astro';
import ProjectDetail from '../../../components/ProjectDetail.astro';
import { contentfulClient, type Project } from '../../../lib/contentful';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Project>({
    content_type: 'project',
    locale: 'en-US',
    'fields.displayed': true,
  });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const pageTitle = item.fields.title;
---
<Layout pageTitle={pageTitle} breadcrumbs={[{ label: t('projects', locale), url: '/en/projects' }, { label: item.fields.title }]}>
  <main>
    <ProjectDetail item={item} locale={locale} />
  </main>
</Layout>
