---
import Layout from '../../../../layouts/Layout.astro';
import ChapterDetail from '../../../../components/ChapterDetail.astro';
import { contentfulClient, type Chapter } from '../../../../lib/contentful';
import { t } from '../../../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Chapter>({ content_type: 'chapitre', locale: 'en-US' });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item, allChapters: response.items },
  }));
}

const { item, allChapters } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

const currentIndex = allChapters.findIndex((ch) => ch.fields.slug === item.fields.slug);
const prevChapter = currentIndex > 0 ? allChapters[currentIndex - 1] : null;
const nextChapter = currentIndex < allChapters.length - 1 ? allChapters[currentIndex + 1] : null;
---
<Layout pageTitle={item.fields.title} breadcrumbs={[
    { label: t('stories', locale), url: '/en/stories' },
    { label: t('chapter', locale) },
    { label: item.fields.title }
  ]}>
  <main>
    <ChapterDetail item={item} prevChapter={prevChapter} nextChapter={nextChapter} locale={locale} />
  </main>
</Layout>
