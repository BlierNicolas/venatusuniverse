---
import Layout from '../../../layouts/Layout.astro';
import NewsDetail from '../../../components/NewsDetail.astro';
import { contentfulClient, type News } from '../../../lib/contentful';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<News>({ content_type: 'nouvelle', locale: 'en-US' });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const pageTitle = item.fields.newsTitle;
---
<Layout pageTitle={pageTitle} breadcrumbs={[{ label: t('news', locale), url: '/en/news' }, { label: item.fields.newsTitle }]}>
  <main>
    <NewsDetail item={item} locale={locale} />
  </main>
</Layout>
