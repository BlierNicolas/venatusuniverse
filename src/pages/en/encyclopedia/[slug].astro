---
import Layout from '../../../layouts/Layout.astro';
import EncyclopediaDetail from '../../../components/EncyclopediaDetail.astro';
import { contentfulClient, type Theory } from '../../../lib/contentful';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Theory>({ content_type: 'theorie', locale: 'en-US' });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const pageTitle = item.fields.title;
---
<Layout pageTitle={pageTitle} breadcrumbs={[{ label: t('encyclopedia', locale), url: '/en/encyclopedia' }, { label: item.fields.title }]}>
  <main>
    <EncyclopediaDetail item={item} />
  </main>
</Layout>
