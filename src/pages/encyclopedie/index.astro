---
import Layout from '../../layouts/Layout.astro';
import EncyclopediaList from '../../components/EncyclopediaList.astro';
import { contentfulClient, type Theory, mapLocale } from '../../lib/contentful';
import { t } from '../../i18n';

const locale = Astro.currentLocale ?? 'fr';
const pageTitle = t('encyclopedia', locale);

const response = await contentfulClient.getEntries<Theory>({ content_type: 'theorie', locale: mapLocale(locale) });
const theories = response.items;
---
<Layout pageTitle={pageTitle}>
  <main>
    <EncyclopediaList items={theories} locale={locale} />
  </main>
</Layout>
