---
import Layout from '../../layouts/Layout.astro';
import PowerDetail from '../../components/PowerDetail.astro';
import { contentfulClient, type Power, type Character, mapLocale } from '../../lib/contentful';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Power>({ content_type: 'pouvoir', locale: 'fr-CA' });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'fr';

const charResponse = await contentfulClient.getEntries<Character>({
  content_type: 'personnage',
  locale: mapLocale(locale),
  'fields.powerName': item.fields.name,
});
const relatedChars = charResponse.items;
---
<Layout pageTitle={item.fields.name} breadcrumbs={[{ label: t('powers', locale), url: '/pouvoirs' }, { label: item.fields.name }]}>
  <main>
    <PowerDetail item={item} relatedChars={relatedChars} locale={locale} />
  </main>
</Layout>
