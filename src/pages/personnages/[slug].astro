---
import Layout from '../../layouts/Layout.astro';
import CharacterDetail from '../../components/CharacterDetail.astro';
import { contentfulClient, type Character, type GroupMember, mapLocale } from '../../lib/contentful';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Character>({ content_type: 'personnage', include: 2, locale: 'fr-CA' });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'fr';
const spaceId = import.meta.env.CONTENTFUL_SPACE_ID;

const groupResponse = await contentfulClient.getEntries<GroupMember>({
  content_type: 'membreGroupe',
  locale: mapLocale(locale),
  'fields.memberSlug': item.fields.slug,
});
const memberships = groupResponse.items;
---
<Layout pageTitle={item.fields.fullName} breadcrumbs={[{ label: t('characters', locale), url: '/personnages' }, { label: item.fields.fullName }]}>
  <main>
    <CharacterDetail item={item} memberships={memberships} locale={locale} spaceId={spaceId} />
  </main>
</Layout>
