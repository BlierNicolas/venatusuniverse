---
import Layout from '../../layouts/Layout.astro';
import CalendarList from '../../components/CalendarList.astro';
import { contentfulClient, type CalendarEntry, mapLocale } from '../../lib/contentful';
import { t } from '../../i18n';

const locale = Astro.currentLocale ?? 'fr';
const pageTitle = t('calendar', locale);

const response = await contentfulClient.getEntries<CalendarEntry>({ content_type: 'calendrier', locale: mapLocale(locale) });
const entries = response.items;
---
<Layout pageTitle={pageTitle}>
  <main>
    <CalendarList items={entries} locale={locale} />
  </main>
</Layout>
