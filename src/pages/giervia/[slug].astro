---
import Layout from '../../layouts/Layout.astro';
import GierviaDetail from '../../components/GierviaDetail.astro';
import { contentfulClient, type Country, type City, mapLocale } from '../../lib/contentful';
import { t } from '../../i18n';

export async function getStaticPaths() {
  const response = await contentfulClient.getEntries<Country>({ content_type: 'pays', include: 2, locale: 'fr-CA' });
  return response.items.map((item) => ({
    params: { slug: item.fields.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const locale = Astro.currentLocale ?? 'fr';
const spaceId = import.meta.env.CONTENTFUL_SPACE_ID;

const cityResponse = await contentfulClient.getEntries<City>({
  content_type: 'ville',
  locale: mapLocale(locale),
  'fields.slugCountry': item.fields.slug,
});
const cities = cityResponse.items;
---
<Layout pageTitle={item.fields.name} breadcrumbs={[{ label: t('giervia', locale), url: '/giervia' }, { label: item.fields.name }]}>
  <main>
    <GierviaDetail item={item} cities={cities} locale={locale} spaceId={spaceId} />
  </main>
</Layout>
