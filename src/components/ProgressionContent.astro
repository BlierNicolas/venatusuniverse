---
import type { Entry } from 'contentful';
import type { Story } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  ongoing: Entry<Story>[];
  finished: Entry<Story>[];
  unknown: Entry<Story>[];
  locale: string;
}

const { ongoing, finished, unknown, locale } = Astro.props;
const storyBase = locale === 'fr' ? '/histoires' : '/en/stories';
---
<section>
  <h2>{t('ongoingLabel', locale)}</h2>
  <ul>
    {ongoing.map((story) => (
      <li>
        <a href={`${storyBase}/${story.fields.slug}`}>{story.fields.title}</a>
        &mdash; {story.fields.currentChapter ?? 0} / {story.fields.maximumChapter ?? '?'}
      </li>
    ))}
  </ul>
</section>

<section>
  <h2>{t('finishedLabel', locale)}</h2>
  <ul>
    {finished.map((story) => (
      <li>
        <a href={`${storyBase}/${story.fields.slug}`}>{story.fields.title}</a>
        &mdash; {story.fields.currentChapter} / {story.fields.maximumChapter}
      </li>
    ))}
  </ul>
</section>

{unknown.length > 0 && (
  <section>
    <h2>{t('undefinedLabel', locale)}</h2>
    <ul>
      {unknown.map((story) => (
        <li>
          <a href={`${storyBase}/${story.fields.slug}`}>{story.fields.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}
