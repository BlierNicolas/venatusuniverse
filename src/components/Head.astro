<meta name="description" content="Welcome to Venatus Universe, my fantasy universe!">

<!-- Web analytics -->
<script data-goatcounter="https://my-account.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>

<!-- Open Graph tags -->
<meta property="og:title" content="Venatus Universe" />
<meta property="og:type" content="website" />
<meta property="og:url" content="https://www.venatusuniverse.com/" />
<meta property="og:description" content="Welcome to Venatus Universe, my fantasy universe!" />
<meta property="og:image" content="https://www.example.com/_astro/seo-banner.BZD7kegZ.webp">
<meta property="og:image:alt" content="">