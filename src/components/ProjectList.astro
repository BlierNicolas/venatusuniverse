---
import type { Entry } from 'contentful';
import type { Project } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<Project>[];
  locale: string;
}

const { items, locale } = Astro.props;
const base = locale === 'fr' ? '/projets' : '/en/projects';
const title = t('projects', locale);
---
<h1>{title}</h1>
<div class="projects-grid">
  {items.map((project) => (
    <article class="project-card">
      <h2><a href={`${base}/${project.fields.slug}`}>{project.fields.title}</a></h2>
      <p>{project.fields.summary}</p>
      <p><strong>{project.fields.projectType}</strong> &mdash; {project.fields.finished ? t('completed', locale) : t('inProgress', locale)}</p>
    </article>
  ))}
</div>
