---
import { getLocalizedUrl, t } from '../i18n';

const locale = Astro.currentLocale ?? 'fr';
---

<style>
  footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #ccc;
    text-align: center;
  }
  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .powered-by {
    margin: 1rem 0;
  }
  .copyright {
    font-size: 0.85rem;
  }
</style>

<footer>
  <div class="social-links" aria-label={locale === 'fr' ? 'Réseaux sociaux' : 'Social media'}>
    <a href="https://www.twitch.tv/wamien" target="_blank" rel="noopener noreferrer">Twitch</a>
    <a href="https://www.youtube.com/@Wamien" target="_blank" rel="noopener noreferrer">YouTube</a>
    <a href="https://www.facebook.com/CreateurDesNouveauxHumains" target="_blank" rel="noopener noreferrer">Facebook</a>
  </div>
  <p class="facebook-prompt">{t('facebookPrompt', locale)}</p>
  <nav class="footer-links" aria-label={locale === 'fr' ? 'Liens utiles' : 'Useful links'}>
    <a href={getLocalizedUrl(locale, '/contributors')}>{t('contributors', locale)}</a>
    <a href={getLocalizedUrl(locale, '/numbers')}>{t('universeInNumbers', locale)}</a>
  </nav>
  <div class="powered-by">
    <a href="https://www.contentful.com/" target="_blank" rel="noopener noreferrer">
      <img src="https://images.ctfassets.net/fo9twyrwpveg/7F5pMEOhJ6Y2WukCa2cYws/398e290725ef2d3b3f0f5a73ae8401d6/PoweredByContentful_DarkBackground.svg" alt="Powered by Contentful" width="200" />
    </a>
  </div>
  <p class="copyright">Venatus Universe &copy;2021</p>
</footer>