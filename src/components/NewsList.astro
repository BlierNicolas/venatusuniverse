---
import type { Entry } from 'contentful';
import type { News } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<News>[];
  locale: string;
}

const { items, locale } = Astro.props;
const base = locale === 'fr' ? '/nouvelles' : '/en/news';
const title = t('news', locale);
---
<h1>{title}</h1>
<ul>
  {items.map((item) => (
    <li>
      <article>
        <h2><a href={`${base}/${item.fields.slug}`}>{item.fields.newsTitle}</a></h2>
        <p class="date">{item.fields.dateSpe}</p>
        <p>{item.fields.description?.slice(0, 200)}{item.fields.description?.length && item.fields.description.length > 200 ? '...' : ''}</p>
      </article>
    </li>
  ))}
</ul>
