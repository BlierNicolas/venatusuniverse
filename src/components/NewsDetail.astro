---
import type { Entry } from 'contentful';
import type { News } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  item: Entry<News>;
  locale: string;
}

const { item, locale } = Astro.props;
const chapterLink = item.fields.referalLink;
---
<article>
  <h1>{item.fields.newsTitle}</h1>
  {item.fields.dateSpe && <p class="date">{item.fields.dateSpe}</p>}
  <p>{item.fields.description}</p>
  {chapterLink && <a href={chapterLink} class="chapter-link">{t('readChapter', locale)}</a>}
</article>
