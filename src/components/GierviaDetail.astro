---
import type { Entry } from 'contentful';
import type { Country, City } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  item: Entry<Country>;
  cities: Entry<City>[];
  locale: string;
  spaceId: string;
}

const { item, cities, locale, spaceId } = Astro.props;

const mapUrl = item.fields.map?.sys?.id
  ? `https://images.ctfassets.net/${spaceId}/${item.fields.map.sys.id}`
  : null;
const flagUrl = item.fields.flag?.sys?.id
  ? `https://images.ctfassets.net/${spaceId}/${item.fields.flag.sys.id}`
  : null;
---
<article>
  {flagUrl && <img src={flagUrl} alt={`${t('flagOf', locale)} ${item.fields.name}`} class="flag" />}
  <h1>{item.fields.name}</h1>
  {item.fields.continentName && <p><strong>{t('continentLabel', locale)}\u00A0:</strong> {item.fields.continentName}</p>}
  {item.fields.description && <p>{item.fields.description}</p>}
  {mapUrl && <img src={mapUrl} alt={`${t('mapOf', locale)} ${item.fields.name}`} class="map" />}

  <ul>
    {item.fields.area != null && <li><strong>{t('areaLabel', locale)}\u00A0:</strong> {item.fields.area} km²</li>}
    {item.fields.population != null && <li><strong>{t('populationLabel', locale)}\u00A0:</strong> {item.fields.population}</li>}
    {item.fields.amountNH != null && <li><strong>{t('newHumansCount', locale)}\u00A0:</strong> {item.fields.amountNH}</li>}
    {item.fields.climate && <li><strong>{t('climateLabel', locale)}\u00A0:</strong> {item.fields.climate}</li>}
    {item.fields.resources && <li><strong>{t('resourcesLabel', locale)}\u00A0:</strong> {item.fields.resources}</li>}
    {item.fields.terrainType && <li><strong>{t('terrainLabel', locale)}\u00A0:</strong> {item.fields.terrainType}</li>}
    {item.fields.leaders && <li><strong>{t('leadersLabel', locale)}\u00A0:</strong> {item.fields.leaders}</li>}
    {item.fields.reputation && <li><strong>{t('reputationLabel', locale)}\u00A0:</strong> {item.fields.reputation}</li>}
    {item.fields.conflict && <li><strong>{t('conflictsLabel', locale)}\u00A0:</strong> {item.fields.conflict}</li>}
    {item.fields.language && <li><strong>{t('languageLabel', locale)}\u00A0:</strong> {item.fields.language}</li>}
    {item.fields.religion && <li><strong>{t('religionLabel', locale)}\u00A0:</strong> {item.fields.religion}</li>}
  </ul>
</article>
  {cities.length > 0 && (
    <section>
      <h2>{t('citiesLabel', locale)}</h2>
      <ul>
        {cities.map((city) => (
          <li>{city.fields.name}</li>
        ))}
      </ul>
    </section>
  )}
