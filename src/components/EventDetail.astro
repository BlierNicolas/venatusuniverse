---
import type { Entry } from 'contentful';
import type { Event } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  item: Entry<Event>;
  locale: string;
}

const { item, locale } = Astro.props;
const storyBase = locale === 'fr' ? '/histoires' : '/en/stories';
---
<article>
  <h1>{item.fields.title}</h1>
  {item.fields.dateSpe && <p class="date">{item.fields.dateSpe}</p>}
  <p>{item.fields.description}</p>
  {item.fields.storySlug && <p><a href={`${storyBase}/${item.fields.storySlug}`}>{item.fields.storyName}</a></p>}
</article>
