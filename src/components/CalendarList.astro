---
import type { Entry } from 'contentful';
import type { CalendarEntry } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<CalendarEntry>[];
  locale: string;
}

const { items, locale } = Astro.props;
const storyBase = locale === 'fr' ? '/histoires' : '/en/stories';
const title = t('calendar', locale);
---
<h1>{title}</h1>
<ul>
  {items.map((entry) => (
    <li>
      <article>
        <h2>{entry.fields.romanSlug ? <a href={`${storyBase}/${entry.fields.romanSlug}`}>{entry.fields.title}</a> : entry.fields.title}</h2>
        <p class="date">{entry.fields.dateSpe}</p>
        <p>{entry.fields.description}</p>
      </article>
    </li>
  ))}
</ul>
