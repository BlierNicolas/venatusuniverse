---
import type { Entry } from 'contentful';
import type { CalendarEntry } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<CalendarEntry>[];
  locale: string;
}

const { items, locale } = Astro.props;
---
<section>
  <h2>{t('upcomingReleases', locale)}</h2>
  {items.length > 0 ? (
    <ul>
      {items.map((item) => (
        <li>
          <article>
            <h3>{item.fields.title}</h3>
            {item.fields.dateSpe && <p class="date">{item.fields.dateSpe}</p>}
            <p>{item.fields.description}</p>
          </article>
        </li>
      ))}
    </ul>
  ) : <p><em>{t('noReleases', locale)}</em></p>}
</section>
