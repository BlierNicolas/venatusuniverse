---
import type { Entry } from 'contentful';
import type { Project } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<Project>[];
  locale: string;
}

const { items, locale } = Astro.props;
const base = locale === 'fr' ? '/projets' : '/en/projects';
---
<section>
  <h2>{t('projectsTitle', locale)}</h2>
  {items.length > 0 ? (
    <div class="projects-grid">
      {items.map((project) => (
        <article class="project-card">
          <h3><a href={`${base}/${project.fields.slug}`}>{project.fields.title}</a></h3>
          <p>{project.fields.summary}</p>
          <p><strong>{project.fields.projectType}</strong></p>
        </article>
      ))}
    </div>
  ) : <p><em>{t('noProjects', locale)}</em></p>}
</section>
