---
import type { Entry } from 'contentful';
import type { Power } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<Power>[];
  locale: string;
}

const { items, locale } = Astro.props;
const base = locale === 'fr' ? '/pouvoirs' : '/en/powers';
const title = t('powers', locale);

const grouped: Record<string, typeof items> = {};
for (const power of items) {
  const letter = (power.fields.name?.[0] ?? '#').toUpperCase();
  if (!grouped[letter]) grouped[letter] = [];
  grouped[letter].push(power);
}
---
<h1>{title}</h1>
{Object.keys(grouped).sort().map((letter) => (
  <section>
    <h2>{letter}</h2>
    <ul>
      {grouped[letter].map((power) => (
        <li><a href={`${base}/${power.fields.slug}`}>{power.fields.name}</a></li>
      ))}
    </ul>
  </section>
))}
