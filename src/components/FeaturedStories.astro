---
import StoryCard from "../components/StoryCard.astro";
import { contentfulClient } from "../lib/contentful";
import type { Story } from "../lib/contentful";

const entries = await contentfulClient.getEntries<Story>({
  content_type: "infosRomans",
});

const featuredStories = entries.items
  .filter((item) => item.fields.featured)
  .map((item) => {
    const { title, summary, slug } = item.fields;
    return {
      title,
      summary,
      url: `histoires/${slug}`,
      link: "Commencer à lire",
    };
  });
---

<div>
  <h2>Histoires mises en avant</h2>
  <div>
    {
      featuredStories.map((story) => (
        <StoryCard
          title={story.title}
          summary={story.summary}
          url={story.url}
          link={story.link}
        />
      ))
    }
  </div>
</div>
