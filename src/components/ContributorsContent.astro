---
import { t } from '../i18n';

export interface Props {
  locale: string;
}

const { locale } = Astro.props;
const title = t('contributors', locale);
---
<h1>{title}</h1>

{locale === 'fr' ? (
  <ul>
    <li>Thomas Desfossez - Design du site (<a href="https://thomas-desfossez.com">thomas-desfossez.com</a>)</li>
    <li>Sarah Bourque - Illustrations (<a href="https://artstation.com/sarahbourque">artstation.com/sarahbourque</a>)</li>
    <li>Maeva G - Aide à la création de l'Univers</li>
    <li>Marie-Josée Cloutier - Corrections</li>
  </ul>
) : (
  <ul>
    <li>Thomas Desfossez - Site design (<a href="https://thomas-desfossez.com">thomas-desfossez.com</a>)</li>
    <li>Sarah Bourque - Illustrations (<a href="https://artstation.com/sarahbourque">artstation.com/sarahbourque</a>)</li>
    <li>Maeva G - Help with universe creation</li>
    <li>Marie-Josée Cloutier - Corrections</li>
  </ul>
)}
