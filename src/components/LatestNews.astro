---
import type { Entry } from 'contentful';
import type { News } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  items: Entry<News>[];
  locale: string;
}

const { items, locale } = Astro.props;
const base = locale === 'fr' ? '/nouvelles' : '/en/news';
---
<section>
  <h2>{t('latestNews', locale)}</h2>
  {items.length > 0 ? (
    <ul>
      {items.map((item) => (
        <li>
          <article>
            <h3><a href={`${base}/${item.fields.slug}`}>{item.fields.newsTitle}</a></h3>
            <p class="date">{item.fields.dateSpe}</p>
            <p>{item.fields.description}</p>
          </article>
        </li>
      ))}
    </ul>
  ) : <p><em>{t('noNews', locale)}</em></p>}
</section>
