---
import type { Entry } from 'contentful';
import type { Power, Character } from '../lib/contentful';
import { t } from '../i18n';

export interface Props {
  item: Entry<Power>;
  relatedChars: Entry<Character>[];
  locale: string;
}

const { item, relatedChars, locale } = Astro.props;
const charBase = locale === 'fr' ? '/personnages' : '/en/characters';
---
<article>
  <h1>{item.fields.name}</h1>
  <p>{item.fields.description}</p>
</article>
  {relatedChars.length > 0 && (
    <section>
      <h2>{t('charactersWithPower', locale)}</h2>
      <ul>
        {relatedChars.map((ch) => (
          <li><a href={`${charBase}/${ch.fields.slug}`}>{ch.fields.fullName}</a></li>
        ))}
      </ul>
    </section>
  )}
